# --- Required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/printparkk?retryWrites=true&w=majority

# --- Recommended (SEO / OG links use this as the canonical domain) ---
NEXT_PUBLIC_BASE_URL=https://printparkk.onrender.com

# --- Optional: email marketing (welcome emails + quote notifications) ---
# Leave unset and the site works fine, email sending is just skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=PrintParkk <hello@printparkk.com>
NOTIFY_EMAIL=you@example.com

# --- Optional: analytics ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Optional but recommended: real product photos ---
# Free key, instant, no card: https://www.pexels.com/api/
# Run once: PEXELS_API_KEY=your-key npm run fetch-images
PEXELS_API_KEY=
